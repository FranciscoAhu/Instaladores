<Window x:Class="Instaladores.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MainWindow"
        Height="400"
        Width="450"
        Background="{DynamicResource PrimaryBrush}"
        BorderBrush="{DynamicResource PrimaryBrush}"
        BorderThickness="0"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Palette using provided colors (all set to #FF003058) -->
        <SolidColorBrush x:Key="PrimaryBrush" Color="#FF003058" />
        <SolidColorBrush x:Key="PrimaryDarkBrush" Color="#FF003058" />
        <SolidColorBrush x:Key="PrimaryLightBrush" Color="#FF003058" />
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="White" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFFFF" />
        <!-- Accent and button brushes -->
        <SolidColorBrush x:Key="AccentBrush" Color="#FF4DB6E6" />
        <SolidColorBrush x:Key="ButtonBrush" Color="#FF00263D" />

        <!-- Button style that uses the palette -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource ButtonBrush}" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryDarkBrush}" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="Margin" Value="2" />
        </Style>

        <!-- CheckBox text color -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
        </Style>

        <!-- ProgressBar tint -->
        <Style TargetType="ProgressBar">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="Background" Value="#FF193948" />
        </Style>
    </Window.Resources>

    <Grid Margin="10" Background="{StaticResource PrimaryBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Background logo image (placed in assets folder) -->
        <Image Source="assets/logo.png" Stretch="UniformToFill" Opacity="0.06" IsHitTestVisible="False" Grid.RowSpan="2" />

        <Grid Margin="10" Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="60" /> <!-- banner height -->
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top banner (placed in assets folder) -->
            <Image Grid.Row="0" Source="assets/banner.png" Height="60" Stretch="UniformToFill" HorizontalAlignment="Stretch" VerticalAlignment="Top" />

            <!-- Selector de perfiles -->
            <ComboBox Grid.Row="1"
                      ItemsSource="{Binding Profiles}"
                      DisplayMemberPath="Nombre"
                      SelectedItem="{Binding SelectedProfile}"
                      Margin="0,8,0,10"/>

            <!-- Lista de aplicativos (con scroll) -->
            <ListBox Grid.Row="2" ItemsSource="{Binding Apps}" ScrollViewer.VerticalScrollBarVisibility="Auto" Background="#00000000">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,4,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <CheckBox Content="{Binding Nombre}"
                                      IsChecked="{Binding IsSelected}"
                                      VerticalAlignment="Center" />

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                        Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVis}}" Margin="8,0,0,0">
                                <ProgressBar x:Name="pb" Width="150" Height="14" Minimum="0" Maximum="100"
                                             Value="{Binding Progress}" />
                                <TextBlock Width="36" Margin="8,0,0,0" VerticalAlignment="Center" Text="{Binding Progress}"
                                           Foreground="White" HorizontalAlignment="Right" TextAlignment="Right" />
                                <TextBlock Text="%" VerticalAlignment="Center" Foreground="White" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">

            <Button x:Name="AceptarButton" Content="Aceptar"
                    Width="80"
                    Margin="0,0,10,0"
                    Click="Aceptar_Click"/>

            <Button Content="Cancelar"
                    Width="80"
                    Click="Cancelar_Click"/>
        </StackPanel>
    </Grid>
</Window>