<Window x:Name="InstaladorAppCNS" x:Class="Instaladores.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Instaladores"
        Title="InstaladorAppCNS"
        Height="500"
        Width="450"
        Background="{DynamicResource PrimaryBrush}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:InvertedBooleanToVisibilityConverter x:Key="InvertedBoolToVis" />
        <local:ProgressToTextConverter x:Key="ProgressToTextConv" />
        <local:ShowPercentageConverter x:Key="ShowPercentageConv" />

        <SolidColorBrush x:Key="PrimaryBrush" Color="#FF003058" />
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="White" />
        <SolidColorBrush x:Key="AccentBrush" Color="#FF4DB6E6" />
        <SolidColorBrush x:Key="ButtonBrush" Color="#FF00263D" />

        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource ButtonBrush}" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="Margin" Value="2" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
        </Style>

        <Style TargetType="ProgressBar">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="Background" Value="#FF193948" />
        </Style>
    </Window.Resources>

    <Grid Margin="10" Background="{StaticResource PrimaryBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Image Source="assets/logo.png" Opacity="0.06" Stretch="UniformToFill" Grid.RowSpan="2"/>

        <!-- CONTENIDO PRINCIPAL -->
        <Grid Grid.Row="0" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <!-- banner -->
                <RowDefinition Height="Auto"/>
                <!-- combo -->
                <RowDefinition Height="Auto"/>
                <!-- fabricante -->
                <RowDefinition Height="*"/>
                <!-- lista -->
            </Grid.RowDefinitions>

            <!-- Banner -->
            <Image Grid.Row="0"
                   Source="assets/banner.png"
                   Height="60"
                   Stretch="Uniform"/>

            <!-- ComboBox con label -->
            <StackPanel Grid.Row="1" Margin="0,8,0,10">
                <TextBlock Text="Perfil:" Foreground="White" FontSize="11" Margin="0,0,0,4"/>
                <ComboBox ItemsSource="{Binding Profiles}"
                          DisplayMemberPath="Nombre"
                          SelectedItem="{Binding SelectedProfile}"/>
            </StackPanel>


            <!-- FABRICANTE -->
            <Grid Grid.Row="2" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Texto -->
                <TextBlock Text="Fabricante:"
                           Foreground="White"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"/>

                <!-- Botones -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button x:Name="HPButton" Content="HP" Width="70" Height="26" Margin="0,0,8,0" Click="HP_Button"/>
                    <Button x:Name="LenovoButton" Content="Lenovo" Width="70" Height="26" Click="Lenovo_Button"/>
                </StackPanel>
            </Grid>

            <!-- LISTA -->
            <ItemsControl Grid.Row="3" ItemsSource="{Binding Apps}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Height="32">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="28"/>
                            </Grid.ColumnDefinitions>

                            <!-- Check -->
                            <CheckBox Grid.Column="0"
                                      IsChecked="{Binding IsSelected}"
                                      Visibility="{Binding ShowProgress, Converter={StaticResource InvertedBoolToVis}}">
                                <CheckBox.Content>
                                    <TextBlock Text="{Binding Nombre}" Foreground="White"/>
                                </CheckBox.Content>
                            </CheckBox>

                            <!-- Nombre en ejecución -->
                            <TextBlock Grid.Column="0"
                                       Text="{Binding Nombre}"
                                       Foreground="White"
                                       Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVis}}"/>

                            <!-- Barra -->
                            <ProgressBar Grid.Column="1"
                                         Height="14"
                                         Width="180"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="{Binding Progress}"
                                         VerticalAlignment="Center"
                                         Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVis}}"/>

                            <!-- Texto -->
                            <StackPanel Grid.Column="2"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        Margin="4,0,0,0"
                                        Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVis}}">

                                <TextBlock Foreground="White" FontSize="11">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource ProgressToTextConv}">
                                            <Binding Path="Progress"/>
                                            <Binding Path="InstallationSucceeded"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>

                                <TextBlock Text="%"
                                           Foreground="White"
                                           FontSize="11">
                                    <TextBlock.Visibility>
                                        <MultiBinding Converter="{StaticResource ShowPercentageConv}">
                                            <Binding Path="Progress"/>
                                            <Binding Path="InstallationSucceeded"/>
                                        </MultiBinding>
                                    </TextBlock.Visibility>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>

                <ItemsControl.Template>
                    <ControlTemplate TargetType="ItemsControl">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </ControlTemplate>
                </ItemsControl.Template>

            </ItemsControl>
        </Grid>

        <!-- BOTONES ABAJO (este es TU aceptar/cancelar real) -->
        <Grid Grid.Row="1" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Botón Deseleccionar todo (izquierda) -->
            <Button Grid.Column="0"
                    Content="Deseleccionar todo"
                    Width="Auto"
                    Padding="10,4"
                    Click="DeselectAll_Button"/>

            <!-- Botones Aceptar/Cancelar (derecha) -->
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">

                <Button x:Name="AceptarButton"
                        Content="Aceptar"
                        Width="80"
                        Margin="0,0,10,0"
                        Click="Aceptar_Click"/>

                <Button x:Name="CancelarButton"
                        Content="Cancelar"
                        Width="80"
                        Click="Cancelar_Click"/>
            </StackPanel>
        </Grid>

    </Grid>
</Window>
