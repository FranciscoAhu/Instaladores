                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,4,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <CheckBox Content="{Binding Nombre}"
                                      IsChecked="{Binding IsSelected}"
                                      VerticalAlignment="Center" />

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                        Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVis}}" Margin="8,0,0,0">
                                <ProgressBar x:Name="pb" Width="150" Height="14" Minimum="0" Maximum="100" HorizontalAlignment="Right"
                                             Value="{Binding Progress}" />
                                <TextBlock Width="36" Margin="8,0,0,0" VerticalAlignment="Center" Text="{Binding Progress}"
                                           Foreground="White" HorizontalAlignment="Right" TextAlignment="Right" />
                                <TextBlock Text="%" VerticalAlignment="Center" Foreground="White" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">

            <Button x:Name="AceptarButton" Content="Aceptar"
                    Width="80"
                    Margin="0,0,10,0"
                    Click="Aceptar_Click"/>

    </Grid>
</Window>